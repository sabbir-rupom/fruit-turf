{
    "compilerOptions": {
        "target": "ES2022",
        "useDefineForClassFields": true,
        "module": "ESNext",
        "moduleResolution": "Bundler",
        "strict": true,
        "jsx": "react-jsx",
        "noEmit": true,
        "skipLibCheck": true,
        "types": ["vite/client"],
        "forceConsistentCasingInFileNames": true
    },
    "include": ["resources/js/**/*.ts", "resources/js/**/*.tsx", "vite.config.js"]
}
